---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${siteConfig.clinic.phoneRaw}`;
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20 gap-4">
      
      <!-- Brand Logo -->
      <a 
        href="/" 
        class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-teal-700 rounded-lg p-1"
        aria-label="Saukhya Speech and Hearing Clinic - Home"
      >
        <div class="w-10 h-10 rounded-xl bg-teal-800 flex items-center justify-center text-white shadow-xs group-hover:bg-teal-700 transition-colors">
          <svg class="w-6 h-6" viewBox="0 0 40 40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="14" stroke="#F0F7F9" stroke-width="2" stroke-opacity="0.3"/>
            <path d="M15 14C15 11.5 17.5 10 20 10C23 10 25 12 25 14.5C25 18 15 18 15 22.5C15 25.5 17.5 27 20 27C23 27 25 25 25 23" stroke="#FAF9F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M28 16C29.5 17.2 30.5 19 30.5 21" stroke="#D97736" stroke-width="2" stroke-linecap="round"/>
            <path d="M12 24C10.5 22.8 9.5 21 9.5 19" stroke="#D97736" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-teal-900 group-hover:text-teal-700 leading-tight">
            Saukhya
          </span>
          <span class="text-[10px] sm:text-[11px] font-medium tracking-wider text-slate-500 uppercase">
            Speech & Hearing Clinic
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
        <a 
          href="/" 
          class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${currentPath === '/' ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-600 hover:text-teal-800 hover:bg-slate-50'}`}
          data-i18n="nav.home"
        >
          Home
        </a>
        <a 
          href="/services" 
          class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${currentPath.startsWith('/services') ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-600 hover:text-teal-800 hover:bg-slate-50'}`}
          data-i18n="nav.services"
        >
          Services
        </a>
        <a 
          href="/about" 
          class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${currentPath.startsWith('/about') ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-600 hover:text-teal-800 hover:bg-slate-50'}`}
          data-i18n="nav.about"
        >
          About Us
        </a>
        <a 
          href="#contact" 
          class="px-3 py-2 rounded-md text-sm font-medium text-slate-600 hover:text-teal-800 hover:bg-slate-50 transition-colors"
          data-i18n="nav.contact"
        >
          Contact
        </a>
      </nav>

      <!-- Desktop Actions: Language & CTAs -->
      <div class="hidden lg:flex items-center gap-3">
        <LanguageSwitcher variant="header" />

        <a 
          href={phoneLink}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-teal-800 bg-teal-50 hover:bg-teal-100 rounded-lg transition-colors border border-teal-200"
          data-event="call_click"
          data-event-label="header_call"
          aria-label={`Call Saukhya Clinic at ${siteConfig.clinic.phone}`}
        >
          <svg class="w-4 h-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span data-i18n="nav.call">Call Now</span>
        </a>

        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition-colors shadow-xs"
          data-event="whatsapp_click"
          data-event-label="header_whatsapp"
          aria-label="Book on WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
          </svg>
          <span data-i18n="nav.whatsapp">WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Top Actions: Call + Menu Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <LanguageSwitcher variant="header" />
        
        <button 
          type="button" 
          id="mobile-menu-toggle" 
          class="p-2 rounded-lg text-slate-600 hover:text-teal-800 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-teal-700 cursor-pointer"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label="Toggle navigation menu"
        >
          <svg id="icon-menu-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-menu-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div 
    id="mobile-nav-panel" 
    class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg transition-all"
    aria-label="Mobile Navigation"
  >
    <div class="flex flex-col space-y-1">
      <a 
        href="/" 
        class={`px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath === '/' ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-700 hover:bg-slate-50'}`}
        data-i18n="nav.home"
      >
        Home
      </a>
      <a 
        href="/services" 
        class={`px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath.startsWith('/services') ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-700 hover:bg-slate-50'}`}
        data-i18n="nav.services"
      >
        Services
      </a>
      <a 
        href="/about" 
        class={`px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${currentPath.startsWith('/about') ? 'text-teal-800 bg-teal-50 font-semibold' : 'text-slate-700 hover:bg-slate-50'}`}
        data-i18n="nav.about"
      >
        About Us
      </a>
      <a 
        href="#contact" 
        class="px-3 py-2.5 rounded-lg text-base font-medium text-slate-700 hover:bg-slate-50 transition-colors"
        data-i18n="nav.contact"
      >
        Contact
      </a>
    </div>

    <!-- Mobile Quick CTAs Inside Menu -->
    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a 
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3 px-4 bg-emerald-600 text-white rounded-lg font-medium text-sm shadow-xs"
        data-event="whatsapp_click"
        data-event-label="mobile_menu_whatsapp"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
        </svg>
        <span data-i18n="hero.ctaWhatsApp">Book on WhatsApp</span>
      </a>

      <a 
        href={phoneLink}
        class="flex items-center justify-center gap-2 w-full py-3 px-4 bg-teal-50 text-teal-800 border border-teal-200 rounded-lg font-medium text-sm"
        data-event="call_click"
        data-event-label="mobile_menu_call"
      >
        <svg class="w-4 h-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{siteConfig.clinic.phone}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  const openIcon = document.getElementById('icon-menu-open');
  const closeIcon = document.getElementById('icon-menu-close');

  if (toggleBtn && mobilePanel && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      
      if (isExpanded) {
        mobilePanel.classList.add('hidden');
        openIcon.classList.remove('hidden');
        openIcon.classList.add('block');
        closeIcon.classList.add('hidden');
        closeIcon.classList.remove('block');
      } else {
        mobilePanel.classList.remove('hidden');
        openIcon.classList.add('hidden');
        openIcon.classList.remove('block');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('block');
      }
    });

    // Close menu when clicking nav links
    mobilePanel.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobilePanel.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        openIcon.classList.remove('hidden');
        openIcon.classList.add('block');
        closeIcon.classList.add('hidden');
        closeIcon.classList.remove('block');
      });
    });
  }
</script>
