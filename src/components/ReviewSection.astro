---
import siteConfig from '../content/site.config.json';

const { reviews } = siteConfig;
const { rating, reviewCount, reviewLink } = siteConfig.google;
---

<section class="py-12 sm:py-16 bg-slate-50/50" aria-label="Patient Reviews">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Google Badge -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-900">
            ★ {rating} / 5.0
          </span>
          <span class="text-xs text-slate-500 font-medium">({reviewCount} Google reviews)</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="reviews.title">
          Patient & Parent Experiences
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1 max-w-2xl" data-i18n="reviews.subtitle">
          Real feedback from families who visited our Vikhroli clinic.
        </p>
      </div>

      <!-- Google Review Link CTA -->
      <div>
        <a 
          href={reviewLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-slate-800 bg-white hover:bg-slate-100 border border-slate-300 shadow-xs transition-colors"
          data-event="review_click"
          data-event-label="reviews_section_rate_google"
        >
          <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
          <span data-i18n="reviews.cta">Rate & Review on Google</span>
        </a>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((rev) => (
        <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs flex flex-col justify-between">
          <div>
            <!-- Star rating -->
            <div class="flex items-center gap-1 text-amber-400 mb-3" aria-label={`${rev.rating} out of 5 stars`}>
              {Array.from({ length: rev.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Review Text -->
            <p class="text-sm text-slate-700 italic leading-relaxed mb-4">
              "{rev.text}"
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">{rev.author}</span>
            {rev.relation && (
              <span class="text-slate-500 font-medium">{rev.relation}</span>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
