---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';

const { clinic, hours, google } = siteConfig;
const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${clinic.phoneRaw}`;
const directionsLink = google.mapsLink;

const daysList: Array<{ key: keyof typeof hours; label: string }> = [
  { key: 'monday', label: 'Monday' },
  { key: 'tuesday', label: 'Tuesday' },
  { key: 'wednesday', label: 'Wednesday' },
  { key: 'thursday', label: 'Thursday' },
  { key: 'friday', label: 'Friday' },
  { key: 'saturday', label: 'Saturday' },
  { key: 'sunday', label: 'Sunday' }
];
---

<section id="contact" class="py-14 sm:py-20 bg-warm-50/50 border-t border-slate-200 scroll-mt-20" aria-label="Visit and Contact Details">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="text-xs font-bold text-teal-800 uppercase tracking-wider bg-teal-50 px-3 py-1 rounded-full border border-teal-200/60 inline-block mb-3">
        Location &amp; Timings
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight" data-i18n="visit.title">
        Visit Saukhya Clinic
      </h2>
      <p class="text-base text-slate-600 mt-2" data-i18n="visit.subtitle">
        Conveniently located near Vikhroli railway station in Mumbai.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Clinic Details & Timings -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Address & Contact Card -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200 shadow-xs">
          <h3 class="text-lg font-bold text-slate-900 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span data-i18n="visit.addressTitle">Clinic Address</span>
          </h3>
          
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed mb-4">
            <strong>{clinic.fullName}</strong><br />
            {clinic.addressLine1}<br />
            {clinic.addressLine2}<br />
            {clinic.city}, {clinic.state} – {clinic.pincode}
          </p>

          <!-- Proximity & Landmark -->
          <div class="space-y-2 text-xs sm:text-sm text-slate-600 border-t border-slate-100 pt-3">
            <p><strong>Landmark:</strong> {clinic.landmark}</p>
            <p><strong>Parking:</strong> {clinic.parking}</p>
            <p><strong>Entrance:</strong> {clinic.entrance}</p>
          </div>

          <!-- Quick Action Buttons -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mt-6 pt-4 border-t border-slate-100">
            <a 
              href={directionsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold text-teal-900 bg-teal-50 hover:bg-teal-100 border border-teal-200 transition-colors"
              data-event="directions_click"
              data-event-label="visit_directions_btn"
            >
              <svg class="w-4 h-4 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <span data-i18n="visit.directionsBtn">Get Directions</span>
            </a>

            <a 
              href={phoneLink}
              class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors"
              data-event="call_click"
              data-event-label="visit_call_btn"
            >
              <svg class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span data-i18n="visit.callBtn">Call Clinic</span>
            </a>

            <a 
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-colors shadow-xs"
              data-event="whatsapp_click"
              data-event-label="visit_whatsapp_btn"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
              </svg>
              <span data-i18n="visit.whatsappBtn">WhatsApp Us</span>
            </a>
          </div>
        </div>

        <!-- Weekly Timings Table Card -->
        <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200 shadow-xs">
          <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span data-i18n="visit.timingsTitle">Clinic Timings</span>
          </h3>

          <div class="divide-y divide-slate-100 text-xs sm:text-sm">
            {daysList.map(({ key, label }) => {
              const dayHour = hours[key];
              return (
                <div class="py-2.5 flex items-center justify-between">
                  <span class="font-medium text-slate-700">{label}</span>
                  {dayHour.isClosed ? (
                    <span class="text-rose-600 font-semibold px-2 py-0.5 rounded bg-rose-50 border border-rose-100">
                      Closed
                    </span>
                  ) : (
                    <span class="text-slate-900 font-semibold">
                      {dayHour.label}
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </div>

      </div>

      <!-- Right Column: Map Embed & Entrance Photo -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Google Map Embed Container -->
        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-xs aspect-16/11 sm:aspect-16/10 relative">
          <iframe
            title="Saukhya Speech and Hearing Clinic Location in Vikhroli Mumbai"
            src={google.mapsEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full min-h-[300px]"
          ></iframe>
        </div>

        <!-- Entrance Photo Slot -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row items-center gap-4">
          <div class="w-full sm:w-36 h-28 rounded-xl overflow-hidden bg-slate-100 flex-shrink-0 border border-slate-200">
            <img 
              src={siteConfig.photos.entrance} 
              alt="Saukhya Clinic Entrance in Vikhroli" 
              class="w-full h-full object-cover"
              width="144"
              height="112"
              loading="lazy"
            />
          </div>
          <div class="text-left">
            <h4 class="text-sm font-bold text-slate-900 mb-1" data-i18n="visit.entranceTitle">
              Entrance &amp; Accessibility
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed mb-2">
              {clinic.entrance}
            </p>
            <a 
              href={directionsLink}
              target="_blank" 
              rel="noopener noreferrer"
              class="text-xs font-bold text-teal-800 hover:text-teal-950 inline-flex items-center gap-1"
            >
              Open in Google Maps →
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
