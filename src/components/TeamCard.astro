---
interface Props {
  member: {
    id: string;
    name: string;
    role: string;
    qualification: string;
    experience: string;
    specialization: string;
    languages: string;
    photo: string;
    rciReg?: string;
  };
}

const { member } = Astro.props;
---

<div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between">
  <div>
    <!-- Specialist Photo & Header -->
    <div class="flex items-start gap-4 mb-4">
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden bg-teal-50 flex-shrink-0 border border-teal-100">
        <img 
          src={member.photo} 
          alt={`Specialist portrait for ${member.name}`}
          class="w-full h-full object-cover"
          width="96"
          height="96"
          loading="lazy"
        />
      </div>
      <div>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
          {member.name}
        </h3>
        <p class="text-xs sm:text-sm font-semibold text-teal-700 mb-1">
          {member.role}
        </p>
        <span class="inline-block text-[11px] font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
          {member.qualification}
        </span>
      </div>
    </div>

    <!-- Clinical Details -->
    <div class="space-y-2.5 text-xs sm:text-sm text-slate-600 border-t border-slate-100 pt-3">
      {member.experience && (
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-700 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="font-semibold text-slate-800" data-i18n="team.experience">Experience:</strong> {member.experience}</span>
        </div>
      )}

      {member.specialization && (
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-teal-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><strong class="font-semibold text-slate-800" data-i18n="team.specialization">Areas of Focus:</strong> {member.specialization}</span>
        </div>
      )}

      {member.languages && (
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-teal-700 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span><strong class="font-semibold text-slate-800" data-i18n="team.languages">Languages:</strong> {member.languages}</span>
        </div>
      )}
    </div>
  </div>

  {member.rciReg && (
    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
      <span class="font-medium text-teal-800">{member.rciReg}</span>
      <span class="bg-emerald-50 text-emerald-700 font-semibold px-2 py-0.5 rounded border border-emerald-200">Verified</span>
    </div>
  )}
</div>
