---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';

const { mode, consultationFrom, currency = '₹', note } = siteConfig.pricing;
const whatsappLink = getWhatsAppLink("Fee Inquiry", "Hi, I would like to inquire about the consultation and therapy fees at Saukhya Clinic.");
---

<section class="py-12 sm:py-16 bg-teal-50/50 border-y border-teal-100/80" aria-label="Fee Structure and Consultation Rates">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <span class="text-xs font-bold text-teal-800 uppercase tracking-wider bg-white px-3 py-1 rounded-full border border-teal-200 inline-block mb-3">
      Transparent Pricing
    </span>
    
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="pricing.title">
      Consultation &amp; Fees
    </h2>
    
    <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-xl mx-auto" data-i18n="pricing.subtitle">
      Transparent and affordable clinical care.
    </p>

    <!-- Fee Display Box -->
    <div class="mt-8 bg-white rounded-2xl p-6 sm:p-8 border border-teal-200 shadow-sm inline-block max-w-md w-full">
      {mode === 'from' ? (
        <div class="mb-4">
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-1" data-i18n="pricing.fromLabel">
            Consultation from
          </span>
          <div class="flex items-baseline justify-center gap-1">
            <span class="text-3xl sm:text-4xl font-black text-teal-900">{currency}{consultationFrom}</span>
            <span class="text-xs text-slate-500 font-medium">/ session</span>
          </div>
        </div>
      ) : (
        <div class="mb-4">
          <span class="text-base sm:text-lg font-bold text-slate-900 block" data-i18n="pricing.contactLabel">
            Message us for fees &amp; appointment slots
          </span>
        </div>
      )}

      <p class="text-xs text-slate-500 leading-relaxed mb-6" data-i18n="pricing.disclaimer">
        {note}
      </p>

      <a 
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-5 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-xs transition-colors"
        data-event="whatsapp_click"
        data-event-label="fees_section_whatsapp"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
        </svg>
        <span data-i18n="pricing.cta">Inquire About Fees on WhatsApp</span>
      </a>
    </div>

  </div>
</section>
