---
import siteConfig from '../content/site.config.json';

const { enabled, message, startDate, endDate } = siteConfig.holiday;

// Server-side check against current IST date
let isNoticeActive = false;
if (enabled && startDate && endDate && message) {
  const now = new Date();
  const kolkataDateStr = now.toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' });
  if (kolkataDateStr <= endDate) {
    isNoticeActive = true;
  }
}
---

{isNoticeActive && (
  <aside 
    id="holiday-notice" 
    class="bg-amber-500 text-slate-900 border-b border-amber-600 px-4 py-2.5 text-sm font-medium text-center relative z-40 transition-all duration-200"
    role="alert"
    aria-live="polite"
    data-start-date={startDate}
    data-end-date={endDate}
  >
    <div class="max-w-6xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center justify-center gap-2 mx-auto">
        <svg class="w-5 h-5 flex-shrink-0 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{message}</span>
      </div>
      <button 
        type="button" 
        id="dismiss-holiday-btn"
        class="text-slate-900 hover:text-slate-950 p-1 rounded-md focus:ring-2 focus:ring-slate-900 cursor-pointer"
        aria-label="Dismiss holiday notice"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </aside>
)}

<script>
  // Client-side dismiss handling and date re-verification
  const banner = document.getElementById('holiday-notice');
  const dismissBtn = document.getElementById('dismiss-holiday-btn');
  
  if (banner && dismissBtn) {
    const endDate = banner.getAttribute('data-end-date');
    const dismissedKey = 'saukhya_holiday_dismissed_' + endDate;
    
    if (sessionStorage.getItem(dismissedKey)) {
      banner.style.display = 'none';
    }

    dismissBtn.addEventListener('click', () => {
      banner.style.display = 'none';
      try {
        sessionStorage.setItem(dismissedKey, 'true');
      } catch (e) {}
    });
  }
</script>
