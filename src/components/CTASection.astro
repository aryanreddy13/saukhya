---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';

interface Props {
  titleKey?: string;
  subtitleKey?: string;
}

const { 
  titleKey = "ctaSection.title", 
  subtitleKey = "ctaSection.subtitle" 
} = Astro.props;

const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${siteConfig.clinic.phoneRaw}`;
---

<section class="py-12 sm:py-16 bg-linear-to-br from-teal-900 via-teal-800 to-slate-900 text-white relative overflow-hidden" aria-label="Appointment Call to Action">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-24 -left-24 w-80 h-80 bg-teal-600/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-3" data-i18n={titleKey}>
      Ready to take the first step?
    </h2>
    <p class="text-sm sm:text-base text-teal-100 max-w-xl mx-auto mb-8 leading-relaxed" data-i18n={subtitleKey}>
      Have a question or want to schedule an evaluation? Connect with our team today.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl text-base font-bold text-slate-950 bg-emerald-400 hover:bg-emerald-300 shadow-lg transition-transform duration-150 active:scale-98 w-full sm:w-auto min-h-[48px]"
        data-event="whatsapp_click"
        data-event-label="cta_section_whatsapp"
      >
        <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
        </svg>
        <span data-i18n="ctaSection.btnWhatsApp">Book on WhatsApp</span>
      </a>

      <a 
        href={phoneLink}
        class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl text-base font-semibold text-white bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 shadow-sm transition-colors w-full sm:w-auto min-h-[48px]"
        data-event="call_click"
        data-event-label="cta_section_call"
      >
        <svg class="w-5 h-5 text-teal-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span data-i18n="ctaSection.btnCall">Call Clinic</span>
      </a>
    </div>
  </div>
</section>
