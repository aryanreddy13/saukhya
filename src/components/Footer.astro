---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';
import LanguageSwitcher from './LanguageSwitcher.astro';

const { clinic, hours, google } = siteConfig;
const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${clinic.phoneRaw}`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800" aria-label="Footer Navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-12 border-b border-slate-800">
      
      <!-- Column 1: Brand & Tagline -->
      <div class="lg:col-span-4 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-teal-700 flex items-center justify-center text-white font-bold">
            <svg class="w-5 h-5" viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="14" stroke="#F0F7F9" stroke-width="2" stroke-opacity="0.3"/>
              <path d="M15 14C15 11.5 17.5 10 20 10C23 10 25 12 25 14.5C25 18 15 18 15 22.5C15 25.5 17.5 27 20 27C23 27 25 25 25 23" stroke="#FAF9F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M28 16C29.5 17.2 30.5 19 30.5 21" stroke="#D97736" stroke-width="2" stroke-linecap="round"/>
              <path d="M12 24C10.5 22.8 9.5 21 9.5 19" stroke="#D97736" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">Saukhya</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm" data-i18n="footer.tagline">
          Empathetic, evidence-based speech and hearing therapy in Vikhroli, Mumbai.
        </p>
        
        <div class="pt-2">
          <LanguageSwitcher variant="footer" />
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider" data-i18n="footer.quickLinks">
          Quick Links
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="/" class="hover:text-teal-400 transition-colors" data-i18n="nav.home">Home</a></li>
          <li><a href="/services" class="hover:text-teal-400 transition-colors" data-i18n="nav.services">Services</a></li>
          <li><a href="/about" class="hover:text-teal-400 transition-colors" data-i18n="nav.about">About Us</a></li>
          <li><a href="#contact" class="hover:text-teal-400 transition-colors" data-i18n="nav.contact">Contact &amp; Timings</a></li>
          <li><a href="/privacy" class="hover:text-teal-400 transition-colors" data-i18n="footer.privacy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact Details -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider" data-i18n="footer.contactInfo">
          Contact Info
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-400">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{clinic.fullAddress}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={phoneLink} class="hover:text-white transition-colors" data-event="call_click" data-event-label="footer_phone">
              {clinic.phone}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
            </svg>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" data-event="whatsapp_click" data-event-label="footer_whatsapp">
              {clinic.whatsapp}
            </a>
          </li>
          <li>
            <a 
              href={google.reviewLink} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-amber-400 hover:text-amber-300 font-medium text-xs mt-1"
              data-event="review_click"
              data-event-label="footer_review_link"
            >
              ★ <span data-i18n="footer.reviewUs">Leave a Google Review</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Timings -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider" data-i18n="footer.timings">
          Clinic Hours
        </h3>
        <p class="text-xs text-slate-400">Mon – Sat: 10:00 AM – 8:00 PM</p>
        <p class="text-xs text-slate-400">Sunday: Closed</p>
        <p class="text-[11px] text-teal-400/80 pt-2">Prior appointment recommended.</p>
      </div>

    </div>

    <!-- Station, Parking & Entrance Notice strip -->
    <div class="py-4 text-xs text-slate-400 border-b border-slate-800 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-2">
      <span class="font-medium text-slate-300">
        📍 {clinic.landmark}
      </span>
      <span class="text-slate-400">
        Parking: {clinic.parking} · Entrance: {clinic.entrance}
      </span>
    </div>

    <!-- Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {currentYear} {clinic.fullName}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
        <span>·</span>
        <a href="#contact" class="hover:text-slate-300 transition-colors">Contact</a>
      </div>
    </div>

  </div>
</footer>
