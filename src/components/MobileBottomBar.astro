---
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';

const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${siteConfig.clinic.phoneRaw}`;
const directionsLink = siteConfig.google.mapsLink;
---

<nav 
  class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white border-t border-slate-200 px-3 py-2 shadow-2xl safe-area-bottom"
  aria-label="Mobile quick actions"
>
  <div class="grid grid-cols-3 gap-2 max-w-md mx-auto items-center">
    
    <!-- 1. Call Button -->
    <a 
      href={phoneLink}
      class="flex flex-col items-center justify-center min-h-[50px] px-2 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-900 border border-teal-200 rounded-xl transition-colors active:scale-98"
      data-event="call_click"
      data-event-label="sticky_bottom_call"
      aria-label="Call clinic directly"
    >
      <svg class="w-5 h-5 text-teal-700 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="text-xs font-semibold" data-i18n="nav.call">Call</span>
    </a>

    <!-- 2. WhatsApp Button (Primary CTA in Center) -->
    <a 
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center min-h-[50px] px-2 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl shadow-md transition-colors active:scale-98"
      data-event="whatsapp_click"
      data-event-label="sticky_bottom_whatsapp"
      aria-label="Chat and book on WhatsApp"
    >
      <svg class="w-5 h-5 text-white mb-0.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
      </svg>
      <span class="text-xs font-bold" data-i18n="nav.whatsapp">WhatsApp</span>
    </a>

    <!-- 3. Directions Button -->
    <a 
      href={directionsLink}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center min-h-[50px] px-2 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 rounded-xl transition-colors active:scale-98"
      data-event="directions_click"
      data-event-label="sticky_bottom_directions"
      aria-label="Get directions to Saukhya Clinic on Google Maps"
    >
      <svg class="w-5 h-5 text-slate-700 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="text-xs font-semibold" data-i18n="nav.directions">Directions</span>
    </a>

  </div>
</nav>
