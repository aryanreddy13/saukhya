---
import siteConfig from '../content/site.config.json';

const { rating, reviewCount, reviewLink } = siteConfig.google;
const { yearsExperience, servicesUnderOneRoof, languagesSpoken } = siteConfig.trust;
---

<section class="border-y border-slate-200/90 bg-slate-50/70 py-6 sm:py-8" aria-label="Clinic Highlights">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 items-center justify-between text-center md:text-left">
      
      <!-- 1. Google Rating & Reviews -->
      <div class="flex flex-col items-center md:items-start p-2">
        <a 
          href={reviewLink} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group inline-flex flex-col items-center md:items-start"
          data-event="review_click"
          data-event-label="trust_strip_google_rating"
        >
          <div class="flex items-center gap-1.5 mb-1">
            <span class="text-amber-500 font-bold text-lg leading-none">★</span>
            <span class="text-xl sm:text-2xl font-black text-slate-900 leading-none">{rating}</span>
            <span class="text-xs font-semibold px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 ml-1">Google</span>
          </div>
          <span class="text-xs font-medium text-slate-600 group-hover:text-teal-700 transition-colors">
            {reviewCount} verified reviews →
          </span>
        </a>
      </div>

      <!-- 2. Clinical Experience -->
      <div class="flex flex-col items-center md:items-start p-2 border-l-0 md:border-l border-slate-200 md:pl-6">
        <span class="text-xl sm:text-2xl font-black text-teal-800 leading-none mb-1">
          {yearsExperience}
        </span>
        <span class="text-xs font-medium text-slate-600" data-i18n="trust.experience">
          Years Clinical Experience
        </span>
      </div>

      <!-- 3. Services Under One Roof -->
      <div class="flex flex-col items-center md:items-start p-2 border-l-0 md:border-l border-slate-200 md:pl-6">
        <span class="text-sm sm:text-base font-bold text-slate-900 leading-snug mb-1">
          {servicesUnderOneRoof}
        </span>
        <span class="text-xs font-medium text-slate-600" data-i18n="trust.services">
          Services Under One Roof
        </span>
      </div>

      <!-- 4. Languages Spoken -->
      <div class="flex flex-col items-center md:items-start p-2 border-l-0 md:border-l border-slate-200 md:pl-6">
        <span class="text-sm sm:text-base font-bold text-slate-900 leading-snug mb-1">
          {languagesSpoken}
        </span>
        <span class="text-xs font-medium text-slate-600" data-i18n="trust.languages">
          Languages Spoken
        </span>
      </div>

    </div>
  </div>
</section>
