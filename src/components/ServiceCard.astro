---
import { getWhatsAppLink } from '../utils/whatsapp';

interface Props {
  service: {
    id: string;
    category: string;
    name: string;
    shortDesc: string;
    whoItHelps?: string;
    image?: string;
  };
}

const { service } = Astro.props;
const whatsappLink = getWhatsAppLink(service.name);
---

<div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group">
  <div>
    <!-- Icon & Title -->
    <div class="flex items-center gap-3.5 mb-3.5">
      {service.image && (
        <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center p-2 flex-shrink-0 group-hover:bg-teal-100 transition-colors">
          <img 
            src={service.image} 
            alt={`${service.name} icon`}
            class="w-8 h-8 object-contain"
            width="32"
            height="32"
            loading="lazy"
          />
        </div>
      )}
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
        {service.name}
      </h3>
    </div>

    <!-- Short Description -->
    <p class="text-sm text-slate-600 leading-relaxed mb-4">
      {service.shortDesc}
    </p>

    <!-- Who It Helps -->
    {service.whoItHelps && (
      <div class="bg-slate-50 rounded-xl p-3 mb-5 border border-slate-100">
        <span class="text-[11px] font-bold text-teal-800 uppercase tracking-wider block mb-1" data-i18n="services.whoItHelps">
          Who this helps:
        </span>
        <p class="text-xs text-slate-600 leading-normal">
          {service.whoItHelps}
        </p>
      </div>
    )}
  </div>

  <!-- Contextual WhatsApp CTA -->
  <div class="pt-2">
    <a 
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl text-xs sm:text-sm font-semibold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors duration-150 active:scale-98 min-h-[44px]"
      data-event="whatsapp_click"
      data-event-label={`service_card_${service.id}`}
      data-service={service.id}
    >
      <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
      </svg>
      <span>Book {service.name} on WhatsApp</span>
    </a>
  </div>
</div>
