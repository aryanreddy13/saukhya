---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';

const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${siteConfig.clinic.phoneRaw}`;
---

<Layout 
  title="Page Not Found | Saukhya Clinic"
  description="Sorry, the page you are looking for does not exist. Connect with Saukhya Speech & Hearing Clinic in Vikhroli, Mumbai."
  currentPath="/404"
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-warm-50/70">
    <div class="max-w-md w-full text-center bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-lg">
      
      <!-- 404 Badge -->
      <div class="w-16 h-16 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center mx-auto mb-5 text-teal-800 font-black text-2xl shadow-xs">
        404
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2" data-i18n="notFound.title">
        Page Not Found
      </h1>

      <p class="text-sm sm:text-base font-medium text-slate-700 mb-2" data-i18n="notFound.subtitle">
        Sorry, we couldn't find that page.
      </p>

      <p class="text-xs text-slate-500 mb-8 leading-relaxed" data-i18n="notFound.description">
        The link might be outdated, or the address may have been entered incorrectly.
      </p>

      <div class="flex flex-col gap-3">
        <!-- Go Home Button -->
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-5 py-3.5 rounded-xl text-sm font-bold text-white bg-teal-800 hover:bg-teal-700 shadow-xs transition-colors"
          data-i18n="notFound.goHome"
        >
          Go Home
        </a>

        <!-- WhatsApp Button -->
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors"
          data-event="whatsapp_click"
          data-event-label="404_whatsapp"
        >
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
          </svg>
          <span data-i18n="notFound.whatsapp">WhatsApp</span>
        </a>

        <!-- Call Button -->
        <a 
          href={phoneLink}
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 transition-colors"
          data-event="call_click"
          data-event-label="404_call"
        >
          <svg class="w-4 h-4 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span data-i18n="notFound.call">Call Clinic</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
