---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../content/site.config.json';
import { getWhatsAppLink } from '../utils/whatsapp';
import TeamCard from '../components/TeamCard.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const whatsappLink = getWhatsAppLink();
const phoneLink = `tel:${siteConfig.clinic.phoneRaw}`;
const { reviewLink } = siteConfig.google;

const reasons = [
  {
    titleKey: "about.reason1Title",
    descKey: "about.reason1Desc",
    defaultTitle: "Qualified, RCI-Registered Specialists",
    defaultDesc: "Ethical care delivered by trained professionals adhering to recognized clinical standards."
  },
  {
    titleKey: "about.reason2Title",
    descKey: "about.reason2Desc",
    defaultTitle: "Child-Friendly, Stress-Free Space",
    defaultDesc: "A welcoming, toy-assisted environment where children feel safe and excited to participate."
  },
  {
    titleKey: "about.reason3Title",
    descKey: "about.reason3Desc",
    defaultTitle: "Family & Caregiver Involvement",
    defaultDesc: "Parents are guided at every stage with practical strategies for daily home reinforcement."
  },
  {
    titleKey: "about.reason4Title",
    descKey: "about.reason4Desc",
    defaultTitle: "Speech & Hearing Under One Roof",
    defaultDesc: "Integrated diagnosis and rehabilitation without having to travel to multiple centers."
  },
  {
    titleKey: "about.reason5Title",
    descKey: "about.reason5Desc",
    defaultTitle: "Central Vikhroli Location",
    defaultDesc: "Easily accessible for families across Eastern Mumbai and Central suburbs."
  }
];

const approachPillars = [
  { title: "Thorough Clinical Assessment", desc: "Standardized evaluation protocols tailored to age and developmental level." },
  { title: "Clear & Open Communication", desc: "No complex jargon. We explain findings in plain, everyday language." },
  { title: "Realistic, Measurable Goals", desc: "Practical milestones established collaboratively with parents and patients." },
  { title: "Personalized Therapy Plans", desc: "Interventions structured around individual learning styles and needs." },
  { title: "Family & Home Involvement", desc: "Actionable home guidance so progress continues naturally outside sessions." },
  { title: "Regular Follow-Ups", desc: "Periodic reviews to adjust therapy pacing and ensure steady advancement." }
];
---

<Layout 
  title="About Saukhya Clinic | Speech & Hearing Specialists Vikhroli"
  description="Learn about Saukhya Speech & Hearing Clinic's mission, qualified team of RCI-registered specialists, patient-first approach, and facilities in Vikhroli, Mumbai."
  currentPath="/about"
>
  
  <!-- 1. OUR STORY -->
  <section class="pt-10 pb-12 sm:pt-16 sm:pb-20 bg-linear-to-b from-teal-50/70 to-white border-b border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold text-teal-800 uppercase tracking-wider bg-teal-100/70 px-3 py-1 rounded-full border border-teal-200 inline-block mb-3">
        About Saukhya
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6" data-i18n="about.storyTitle">
        Our Story &amp; Purpose
      </h1>
      <div class="space-y-4 text-base sm:text-lg text-slate-700 leading-relaxed text-left sm:text-center max-w-3xl mx-auto">
        <p data-i18n="about.storyP1">
          Saukhya was founded with a single mission: to provide empathetic, evidence-based speech, language, and hearing care to families in and around Vikhroli, Mumbai.
        </p>
        <p data-i18n="about.storyP2">
          Communication and hearing are fundamental to how we learn, express emotions, and connect with loved ones. We strive to make therapy an encouraging, stress-free experience for children, adults, and seniors alike.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. OUR APPROACH -->
  <section class="py-12 sm:py-16 bg-white" aria-label="Our Clinical Approach">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-teal-800 uppercase tracking-wider bg-teal-50 px-3 py-1 rounded-full border border-teal-200 inline-block mb-3">
          Evidence-Based Care
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="about.approachTitle">
          Our Clinical Approach
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 max-w-2xl mx-auto" data-i18n="about.approachP">
          We believe effective care starts with listening. We prioritize thorough clinical assessments, realistic milestone setting, transparent parent counseling, and engaging home practice routines. We do not make exaggerated outcome guarantees; we focus on steady, measurable progress.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {approachPillars.map((pillar, idx) => (
          <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 shadow-xs">
            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-900 font-bold flex items-center justify-center mb-3">
              {idx + 1}
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-1.5">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {pillar.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 3. MEET THE TEAM -->
  <section class="py-12 sm:py-16 bg-slate-50/70 border-t border-slate-200" aria-label="Meet The Team">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold text-teal-800 uppercase tracking-wider bg-teal-100/70 px-3 py-1 rounded-full border border-teal-200 inline-block mb-3">
          Our Team
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="team.title">
          Meet Our Specialists
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2" data-i18n="team.subtitle">
          Certified professionals dedicated to compassionate, personalized speech and hearing therapy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {siteConfig.team.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. WHY FAMILIES CHOOSE US -->
  <section class="py-12 sm:py-16 bg-white border-t border-slate-200" aria-label="Why Choose Saukhya">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-i18n="about.reasonsTitle">
          Why Families Trust Saukhya
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reasons.map((r, i) => (
          <div class="bg-warm-50/60 rounded-2xl p-6 border border-slate-200">
            <div class="w-8 h-8 rounded-lg bg-teal-800 text-white font-bold text-xs flex items-center justify-center mb-3">
              ✓
            </div>
            <h3 class="text-base font-bold text-slate-900 mb-1.5" data-i18n={r.titleKey}>
              {r.defaultTitle}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed" data-i18n={r.descKey}>
              {r.defaultDesc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. COMMUNITY WORK -->
  <section class="py-12 sm:py-16 bg-slate-50/70 border-t border-slate-200" aria-label="Community Health Outreach">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6">
          <span class="text-xs font-bold text-amber-700 uppercase tracking-wider bg-amber-50 px-3 py-1 rounded-full border border-amber-200 inline-block mb-3">
            Social Impact
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4" data-i18n="about.communityTitle">
            Community Health Outreach
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6" data-i18n="about.communityDesc">
            We regularly organize community awareness initiatives and free screening camps to identify developmental speech and hearing concerns early in children and seniors.
          </p>
          <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs text-slate-600 space-y-2">
            <p class="flex items-center gap-2 font-medium text-slate-800">
              <span class="w-2 h-2 rounded-full bg-teal-600"></span>
              Early childhood speech screening in local preschools
            </p>
            <p class="flex items-center gap-2 font-medium text-slate-800">
              <span class="w-2 h-2 rounded-full bg-teal-600"></span>
              Senior citizen hearing aid guidance &amp; check-up camps
            </p>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="rounded-2xl overflow-hidden border border-slate-200 bg-white shadow-sm aspect-16/11">
            <img 
              src="/images/clinic/camp-photo.svg" 
              alt="Saukhya Community Health Camp in Mumbai"
              class="w-full h-full object-cover"
              width="600"
              height="400"
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 6. THE CLINIC PHOTO GRID (5-8 Photos with Lightbox) -->
  <PhotoGallery 
    photos={siteConfig.photos.aboutGallery}
    title="Our Facility & Consultation Rooms"
    subtitle="Take a look inside our clean, calm, and fully equipped clinic in Vikhroli."
  />

  <!-- 7. OUR PROMISE -->
  <section class="py-12 sm:py-16 bg-white border-t border-slate-200" aria-label="Our Promise">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4" data-i18n="about.promiseTitle">
        Our Commitment to You
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto mb-6" data-i18n="about.promiseDesc">
        Honesty, patient dignity, privacy, and clear communication are at the heart of everything we do. We will always give you our objective clinical guidance.
      </p>
    </div>
  </section>

  <!-- 8. CTA SECTION (WhatsApp, Call, Rate on Google) -->
  <section class="py-12 sm:py-16 bg-teal-900 text-white" aria-label="About Page CTAs">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">
        Connect With Our Specialists
      </h2>
      <p class="text-teal-100 text-sm sm:text-base max-w-xl mx-auto mb-8">
        We are here to answer your questions and guide your family with care.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5">
        <a 
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm sm:text-base font-bold text-slate-950 bg-emerald-400 hover:bg-emerald-300 transition-colors shadow-md w-full sm:w-auto min-h-[48px]"
          data-event="whatsapp_click"
          data-event-label="about_cta_whatsapp"
        >
          <svg class="w-5 h-5 text-slate-950" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.678.077-1.138-.073-.298-.098-.679-.228-1.229-.467-2.345-1.018-3.874-3.4-3.993-3.559-.117-.159-.958-1.275-.958-2.43 0-1.157.607-1.724.823-1.96.216-.236.471-.295.628-.295.157 0 .314.002.451.009.147.007.345-.056.54.412.206.495.706 1.722.765 1.843.06.12.1.261.02.421-.08.16-.12.26-.24.4-.12.14-.251.312-.36.42-.12.12-.244.25-.105.49.14.24.62 1.024 1.33 1.657.915.815 1.688 1.068 1.928 1.188.24.12.38.1.52-.06.14-.16.6-.7.76-.94.16-.24.32-.2.54-.12.22.08 1.4.66 1.64.78.24.12.4.18.46.28.06.1.06.58-.08.985z"/>
          </svg>
          <span data-i18n="hero.ctaWhatsApp">Book on WhatsApp</span>
        </a>

        <a 
          href={phoneLink}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm sm:text-base font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors w-full sm:w-auto min-h-[48px]"
          data-event="call_click"
          data-event-label="about_cta_call"
        >
          <svg class="w-5 h-5 text-teal-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span data-i18n="hero.ctaCall">Call Clinic</span>
        </a>

        <a 
          href={reviewLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl text-sm font-semibold text-amber-300 hover:text-amber-200 border border-teal-700 hover:border-teal-600 transition-colors w-full sm:w-auto min-h-[48px]"
          data-event="review_click"
          data-event-label="about_cta_google"
        >
          ★ <span data-i18n="reviews.cta">Rate on Google</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
